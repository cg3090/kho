{
  "name": "kho",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "prisma generate && tsx server.ts",
    "start": "prisma generate && node server.ts",
    "build": "prisma generate && vite build",
    "deploy": "npx wrangler deploy",
    "deploy:cloudflare": "npx wrangler deploy",
    "deploy:full": "npx wrangler d1 migrations apply khobd --remote && npx wrangler deploy",
    "d1:migrate": "npx wrangler d1 migrations apply khobd --remote",
    "d1:migrate:local": "npx wrangler d1 migrations apply khobd --local",
    "d1:seed": "npx wrangler d1 execute khobd --remote --file=./drizzle/seed_data.sql",
    "d1:seed:local": "npx wrangler d1 execute khobd --local --file=./drizzle/seed_data.sql",
    "d1:convert-setup": "node scripts/convert_database_setup_to_d1.js",
    "d1:reload": "node scripts/convert_database_setup_to_d1.js && npx wrangler d1 execute khobd --remote --file=./drizzle/d1_reload_data.sql",
    "d1:reload:local": "node scripts/convert_database_setup_to_d1.js && npx wrangler d1 execute khobd --local --file=./drizzle/d1_reload_data.sql",
    "d1:reset": "node scripts/convert_database_setup_to_d1.js && npx wrangler d1 execute khobd --remote --file=./drizzle/d1_reset_and_reload.sql",
    "d1:reset:local": "node scripts/convert_database_setup_to_d1.js && npx wrangler d1 execute khobd --local --file=./drizzle/d1_reset_and_reload.sql",
    "drizzle:generate": "drizzle-kit generate",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "prisma:pull": "prisma db pull",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "test:security": "tsx --test tests/session.test.ts",
    "test:api": "tsx --test tests/netlify-postgres.test.ts",
    "build:api:check": "esbuild netlify/functions/api.ts --bundle --platform=node --format=esm --packages=external --outfile=/tmp/kho-netlify-api-check.js"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@hono/node-server": "^2.1.4",
    "@prisma/client": "^6.5.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "firebase": "^12.15.0",
    "hono": "^4.13.13",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "prisma": "^6.5.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wrangler": "^4.149.0"
  }
}
